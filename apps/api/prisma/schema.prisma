// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ClassroomMemberRole {
  STUDENT
  TEACHER
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum TopicStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamPart {
  FIRST
  SECOND
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomeworkSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  REVIEWED
}

enum KnowledgeMapStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeNodeKind {
  SECTION
  TOPIC
  SUBTOPIC
  SKILL
}

enum KnowledgeDependencyType {
  REQUIRED
  RECOMMENDED
}

enum KnowledgeSourceCoverage {
  DIRECT
  PARTIAL
  MISSING
}

enum SkillVerificationMethod {
  SHORT_ANSWER
  MULTI_STEP_SOLUTION
  ORAL_EXPLANATION
  ERROR_ANALYSIS
  GRAPH_INTERPRETATION
  CONSTRUCTION
  PROOF
  MODELING
}

enum ExamTaskType {
  COMPUTATION
  EQUATION
  INEQUALITY
  GRAPH
  APPLIED_MODEL
  PROBABILITY
  PLANE_GEOMETRY
  STEREOMETRY
  PARAMETER
  NUMBER_THEORY
}

enum TaskSkillRole {
  PRIMARY
  SECONDARY
  PREREQUISITE
}

enum MaterialReviewStatus {
  PENDING
  REVIEWED
  REJECTED
}

enum MaterialSkillRole {
  EXPLAINS
  PRACTICES
  REFERENCES
}

enum KnowledgeReviewItemType {
  COVERAGE_GAP
  EXPERT_REVIEW
}

enum KnowledgeReviewPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role     @default(STUDENT)

  ownedClassrooms      Classroom[]                   @relation("ClassroomOwner")
  classroomMemberships ClassroomMember[]
  favoriteTasks        TaskFavorite[]
  assignedHomework     HomeworkAssignment[]          @relation("HomeworkAssignedBy")
  homeworkRecipients   HomeworkAssignmentRecipient[]
  homeworkSubmissions  HomeworkSubmission[]
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classrooms    Classroom[]
  topics        Topic[]
  knowledgeMaps KnowledgeMap[]
}

model Classroom {
  id          String          @id @default(cuid())
  title       String
  description String?
  inviteCode  String          @unique @default(cuid())
  status      ClassroomStatus @default(ACTIVE)
  ownerId     String
  subjectId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner   User    @relation("ClassroomOwner", fields: [ownerId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  members             ClassroomMember[]
  homeworkAssignments HomeworkAssignment[]

  @@index([ownerId])
  @@index([subjectId])
}

model ClassroomMember {
  classroomId String
  userId      String
  role        ClassroomMemberRole @default(STUDENT)
  joinedAt    DateTime            @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

model Topic {
  id          String      @id @default(cuid())
  subjectId   String
  parentId    String?
  slug        String
  name        String
  description String?
  sortOrder   Int         @default(0)
  status      TopicStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subject  Subject @relation(fields: [subjectId], references: [id])
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id])
  children Topic[] @relation("TopicHierarchy")
  tasks    Task[]

  prerequisiteLinks TopicPrerequisite[] @relation("DependentTopic")
  unlocksTopics     TopicPrerequisite[] @relation("PrerequisiteTopic")

  @@unique([subjectId, slug])
  @@index([subjectId, parentId])
}

model Task {
  id                String     @id @default(cuid())
  publicId          String     @unique
  topicId           String
  examPart          ExamPart
  statement         String
  correctAnswer     String?
  referenceSolution String?
  difficulty        Int        @default(1)
  status            TaskStatus @default(DRAFT)
  source            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  topic               Topic                          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  favorites           TaskFavorite[]
  homeworkAssignments HomeworkAssignmentTask[]
  homeworkAttachments HomeworkSubmissionAttachment[]
  skillLinks          TaskSkill[]

  @@index([topicId, status])
  @@index([examPart, status])
}

model TaskFavorite {
  userId    String
  taskId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([userId, createdAt])
}

model HomeworkAssignment {
  id           String   @id @default(cuid())
  publicId     String   @unique
  title        String
  description  String?
  deadline     DateTime
  classroomId  String
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classroom   Classroom                     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  assignedBy  User                          @relation("HomeworkAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  tasks       HomeworkAssignmentTask[]
  recipients  HomeworkAssignmentRecipient[]
  submissions HomeworkSubmission[]

  @@index([classroomId, deadline])
  @@index([assignedById])
}

model HomeworkAssignmentTask {
  homeworkId String
  taskId     String
  sortOrder  Int    @default(0)

  homework HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  task     Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([homeworkId, taskId])
  @@index([taskId])
}

model HomeworkAssignmentRecipient {
  homeworkId String
  studentId  String
  assignedAt DateTime @default(now())

  homework HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([homeworkId, studentId])
  @@index([studentId, assignedAt])
}

model HomeworkSubmission {
  id          String                   @id @default(cuid())
  publicId    String                   @unique
  homeworkId  String
  studentId   String
  status      HomeworkSubmissionStatus @default(DRAFT)
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  homework    HomeworkAssignment             @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     User                           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments HomeworkSubmissionAttachment[]

  @@unique([homeworkId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([homeworkId, status, submittedAt])
}

model HomeworkSubmissionAttachment {
  id           String   @id @default(cuid())
  publicId     String   @unique
  submissionId String
  taskId       String
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  task       Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([submissionId, taskId])
  @@index([taskId])
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  minimumMastery Int      @default(70)
  createdAt      DateTime @default(now())

  topic        Topic @relation("DependentTopic", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("PrerequisiteTopic", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
}

model KnowledgeMap {
  id            String             @id @default(cuid())
  subjectId     String
  version       Int
  title         String
  description   String?
  sourceSummary String?
  status        KnowledgeMapStatus @default(DRAFT)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  subject     Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  nodes       KnowledgeNode[]
  materials   LearningMaterial[]
  reviewItems KnowledgeReviewItem[]
  references  KnowledgeMapReference[]

  @@unique([subjectId, version])
  @@index([subjectId, status, version])
}

model KnowledgeNode {
  id                String                   @id @default(cuid())
  knowledgeMapId    String
  parentId          String?
  code              String
  kind              KnowledgeNodeKind
  name              String
  description       String?
  sortOrder         Int                      @default(0)
  difficulty        Int?
  importance        Int?
  estimatedMinutes  Int?
  isFoundational    Boolean                  @default(false)
  sourceCoverage    KnowledgeSourceCoverage?
  needsExpertReview Boolean                  @default(false)
  expertReviewNote  String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  knowledgeMap KnowledgeMap    @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  parent       KnowledgeNode?  @relation("KnowledgeNodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     KnowledgeNode[] @relation("KnowledgeNodeHierarchy")

  prerequisiteLinks KnowledgeDependency[]         @relation("DependentKnowledgeNode")
  unlocksSkills     KnowledgeDependency[]         @relation("PrerequisiteKnowledgeNode")
  examMappings      KnowledgeExamMapping[]
  verification      KnowledgeVerificationMethod[]
  taskLinks         TaskSkill[]
  materialLinks     LearningMaterialSkill[]
  reviewLinks       KnowledgeReviewItemSkill[]

  @@unique([knowledgeMapId, code])
  @@index([knowledgeMapId, kind, parentId])
}

model KnowledgeDependency {
  skillId           String
  prerequisiteId    String
  type              KnowledgeDependencyType
  rationale         String?
  needsExpertReview Boolean                 @default(false)
  createdAt         DateTime                @default(now())

  skill        KnowledgeNode @relation("DependentKnowledgeNode", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite KnowledgeNode @relation("PrerequisiteKnowledgeNode", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteId])
  @@index([prerequisiteId, type])
}

model KnowledgeExamMapping {
  skillId    String
  examNumber Int
  examPart   ExamPart
  taskType   ExamTaskType
  weight     Float        @default(1)
  createdAt  DateTime     @default(now())

  skill KnowledgeNode @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, examNumber, taskType])
  @@index([examNumber, examPart, taskType])
}

model KnowledgeVerificationMethod {
  skillId     String
  method      SkillVerificationMethod
  description String?
  sortOrder   Int                     @default(0)

  skill KnowledgeNode @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, method])
}

model TaskSkill {
  taskId    String
  skillId   String
  role      TaskSkillRole @default(PRIMARY)
  weight    Float         @default(1)
  createdAt DateTime      @default(now())

  task  Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill KnowledgeNode @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([taskId, skillId])
  @@index([skillId, role])
}

model LearningMaterial {
  id             String               @id @default(cuid())
  knowledgeMapId String
  fileName       String
  title          String
  pageCount      Int
  checksum       String?
  storageKey     String?
  reviewStatus   MaterialReviewStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  knowledgeMap KnowledgeMap              @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  segments     LearningMaterialSegment[]

  @@unique([knowledgeMapId, fileName])
  @@index([knowledgeMapId, reviewStatus])
}

model LearningMaterialSegment {
  id                String   @id @default(cuid())
  materialId        String
  title             String
  pages             Int[]
  notes             String?
  sortOrder         Int      @default(0)
  needsExpertReview Boolean  @default(false)
  createdAt         DateTime @default(now())

  material   LearningMaterial        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  skillLinks LearningMaterialSkill[]

  @@index([materialId, sortOrder])
}

model LearningMaterialSkill {
  segmentId         String
  skillId           String
  role              MaterialSkillRole @default(REFERENCES)
  confidence        Int               @default(100)
  needsExpertReview Boolean           @default(false)

  segment LearningMaterialSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  skill   KnowledgeNode           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([segmentId, skillId])
  @@index([skillId, role])
}

model KnowledgeReviewItem {
  id             String                   @id @default(cuid())
  knowledgeMapId String
  code           String
  type           KnowledgeReviewItemType
  priority       KnowledgeReviewPriority?
  title          String
  description    String
  resolvedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  knowledgeMap KnowledgeMap               @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  skillLinks   KnowledgeReviewItemSkill[]

  @@unique([knowledgeMapId, code])
  @@index([knowledgeMapId, type, priority])
}

model KnowledgeReviewItemSkill {
  reviewItemId String
  skillId      String

  reviewItem KnowledgeReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  skill      KnowledgeNode       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([reviewItemId, skillId])
  @@index([skillId])
}

model KnowledgeMapReference {
  id             String @id @default(cuid())
  knowledgeMapId String
  title          String
  url            String
  purpose        String
  sortOrder      Int    @default(0)

  knowledgeMap KnowledgeMap @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)

  @@unique([knowledgeMapId, url])
  @@index([knowledgeMapId, sortOrder])
}

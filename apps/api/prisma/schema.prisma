// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ClassroomMemberRole {
  STUDENT
  TEACHER
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum TopicStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamPart {
  FIRST
  SECOND
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomeworkSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  REVIEWED
}

enum KnowledgeMapStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeNodeKind {
  SECTION
  TOPIC
  SUBTOPIC
  SKILL
}

enum KnowledgeDependencyType {
  REQUIRED
  RECOMMENDED
}

enum KnowledgeSourceCoverage {
  DIRECT
  PARTIAL
  MISSING
}

enum SkillVerificationMethod {
  SHORT_ANSWER
  MULTI_STEP_SOLUTION
  ORAL_EXPLANATION
  ERROR_ANALYSIS
  GRAPH_INTERPRETATION
  CONSTRUCTION
  PROOF
  MODELING
}

enum ExamTaskType {
  COMPUTATION
  EQUATION
  INEQUALITY
  GRAPH
  APPLIED_MODEL
  PROBABILITY
  PLANE_GEOMETRY
  STEREOMETRY
  PARAMETER
  NUMBER_THEORY
}

enum TaskSkillRole {
  PRIMARY
  SECONDARY
  PREREQUISITE
}

enum MaterialReviewStatus {
  PENDING
  REVIEWED
  REJECTED
}

enum MaterialSkillRole {
  EXPLAINS
  PRACTICES
  REFERENCES
}

enum KnowledgeReviewItemType {
  COVERAGE_GAP
  EXPERT_REVIEW
}

enum KnowledgeReviewPriority {
  HIGH
  MEDIUM
  LOW
}

enum LearningGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AssessmentSessionType {
  INITIAL_DIAGNOSTIC
}

enum AssessmentSessionStatus {
  EXAM_READY
  EXAM_IN_PROGRESS
  EXAM_REVIEW_PENDING
  CLARIFICATION
  COMPLETED
  ABANDONED
}

enum AssessmentPhase {
  FULL_EXAM
  ADAPTIVE
  THEORY
}

enum AssessmentItemKind {
  TASK
  QUESTION
}

enum AssessmentItemStatus {
  PENDING
  ACTIVE
  ANSWERED
  SKIPPED
  AWAITING_REVIEW
  REVIEWED
}

enum AssessmentAttemptOutcome {
  CORRECT
  INCORRECT
  PARTIAL
  SKIPPED
  UNSTUDIED
  NOT_REACHED
  AWAITING_REVIEW
}

enum AssessmentBehaviorEventType {
  VIEWED
  FOCUS_GAINED
  FOCUS_LOST
  ANSWER_CHANGED
  MARKED_FOR_REVIEW
  WORK_SAVED
}

enum DiagnosticQuestionKind {
  ADAPTIVE_TASK
  THEORY_SHORT
  THEORY_CHOICE
}

enum QuestionEvaluationMode {
  EXACT
  CHOICE
  MANUAL
}

enum DiagnosticHypothesisType {
  SKILL_GAP
  PREREQUISITE_GAP
  COMPUTATION_ERROR
  MISREAD_CONDITION
  TIME_PRESSURE
  CARELESSNESS
  UNSTUDIED
  POSSIBLE_GUESS
}

enum DiagnosticHypothesisStatus {
  OPEN
  CONFIRMED
  REJECTED
  INSUFFICIENT
}

enum SkillEvidenceSource {
  FULL_EXAM
  ADAPTIVE_TASK
  THEORY_QUESTION
  MANUAL_REVIEW
  SELF_REPORT
  HOMEWORK
  CONTROL_WORK
  MOCK_EXAM
  LESSON
  TEACHER_CONFIRMATION
}

enum StudentSkillStatus {
  UNKNOWN
  UNSTUDIED
  GAP
  DEVELOPING
  MASTERED
  INSUFFICIENT_DATA
  WEAK
  LEARNING
  NEEDS_REINFORCEMENT
  NEEDS_REVIEW
  TEACHER_CONFIRMED
}

enum AttemptIndependence {
  UNKNOWN
  INDEPENDENT
  MINOR_HINT
  MAJOR_HELP
}

enum AssessmentReviewErrorType {
  NONE
  COMPUTATION
  CONCEPTUAL
  MODELING
  LOGIC
  NOTATION
  INCOMPLETE
  MISREAD_CONDITION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role     @default(STUDENT)

  ownedClassrooms      Classroom[]                   @relation("ClassroomOwner")
  classroomMemberships ClassroomMember[]
  favoriteTasks        TaskFavorite[]
  assignedHomework     HomeworkAssignment[]          @relation("HomeworkAssignedBy")
  homeworkRecipients   HomeworkAssignmentRecipient[]
  homeworkSubmissions  HomeworkSubmission[]
  learningGoals        StudentLearningGoal[]         @relation("StudentLearningGoals")
  assessmentSessions   AssessmentSession[]           @relation("StudentAssessmentSessions")
  reviewedAttempts     AssessmentAttempt[]           @relation("AssessmentAttemptReviewer")
  skillEvidence        SkillEvidence[]               @relation("StudentSkillEvidence")
  skillStates          StudentSkillState[]           @relation("StudentSkillStates")
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classrooms    Classroom[]
  topics        Topic[]
  knowledgeMaps KnowledgeMap[]
}

model Classroom {
  id          String          @id @default(cuid())
  title       String
  description String?
  inviteCode  String          @unique @default(cuid())
  status      ClassroomStatus @default(ACTIVE)
  ownerId     String
  subjectId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner   User    @relation("ClassroomOwner", fields: [ownerId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  members             ClassroomMember[]
  homeworkAssignments HomeworkAssignment[]

  @@index([ownerId])
  @@index([subjectId])
}

model ClassroomMember {
  classroomId String
  userId      String
  role        ClassroomMemberRole @default(STUDENT)
  joinedAt    DateTime            @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

model Topic {
  id          String      @id @default(cuid())
  subjectId   String
  parentId    String?
  slug        String
  name        String
  description String?
  sortOrder   Int         @default(0)
  status      TopicStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subject  Subject @relation(fields: [subjectId], references: [id])
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id])
  children Topic[] @relation("TopicHierarchy")
  tasks    Task[]

  prerequisiteLinks TopicPrerequisite[] @relation("DependentTopic")
  unlocksTopics     TopicPrerequisite[] @relation("PrerequisiteTopic")

  @@unique([subjectId, slug])
  @@index([subjectId, parentId])
}

model Task {
  id                String     @id @default(cuid())
  publicId          String     @unique
  topicId           String
  examPart          ExamPart
  statement         String
  correctAnswer     String?
  referenceSolution String?
  difficulty        Int        @default(1)
  status            TaskStatus @default(DRAFT)
  source            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  topic               Topic                          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  favorites           TaskFavorite[]
  homeworkAssignments HomeworkAssignmentTask[]
  homeworkAttachments HomeworkSubmissionAttachment[]
  skillLinks          TaskSkill[]
  assessmentItems     AssessmentItem[]
  rubricCriteria      TaskRubricCriterion[]

  @@index([topicId, status])
  @@index([examPart, status])
}

model TaskFavorite {
  userId    String
  taskId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([userId, createdAt])
}

model HomeworkAssignment {
  id           String   @id @default(cuid())
  publicId     String   @unique
  title        String
  description  String?
  deadline     DateTime
  classroomId  String
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classroom   Classroom                     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  assignedBy  User                          @relation("HomeworkAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  tasks       HomeworkAssignmentTask[]
  recipients  HomeworkAssignmentRecipient[]
  submissions HomeworkSubmission[]

  @@index([classroomId, deadline])
  @@index([assignedById])
}

model HomeworkAssignmentTask {
  homeworkId String
  taskId     String
  sortOrder  Int    @default(0)

  homework HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  task     Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([homeworkId, taskId])
  @@index([taskId])
}

model HomeworkAssignmentRecipient {
  homeworkId String
  studentId  String
  assignedAt DateTime @default(now())

  homework HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([homeworkId, studentId])
  @@index([studentId, assignedAt])
}

model HomeworkSubmission {
  id          String                   @id @default(cuid())
  publicId    String                   @unique
  homeworkId  String
  studentId   String
  status      HomeworkSubmissionStatus @default(DRAFT)
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  homework    HomeworkAssignment             @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     User                           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments HomeworkSubmissionAttachment[]

  @@unique([homeworkId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([homeworkId, status, submittedAt])
}

model HomeworkSubmissionAttachment {
  id           String   @id @default(cuid())
  publicId     String   @unique
  submissionId String
  taskId       String
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  task       Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([submissionId, taskId])
  @@index([taskId])
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  minimumMastery Int      @default(70)
  createdAt      DateTime @default(now())

  topic        Topic @relation("DependentTopic", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("PrerequisiteTopic", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
}

model KnowledgeMap {
  id            String             @id @default(cuid())
  subjectId     String
  version       Int
  title         String
  description   String?
  sourceSummary String?
  status        KnowledgeMapStatus @default(DRAFT)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  subject             Subject                      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  nodes               KnowledgeNode[]
  materials           LearningMaterial[]
  reviewItems         KnowledgeReviewItem[]
  references          KnowledgeMapReference[]
  learningGoals       StudentLearningGoal[]
  assessmentSessions  AssessmentSession[]
  diagnosticQuestions DiagnosticQuestionTemplate[]
  skillStates         StudentSkillState[]

  @@unique([subjectId, version])
  @@index([subjectId, status, version])
}

model KnowledgeNode {
  id                String                   @id @default(cuid())
  knowledgeMapId    String
  parentId          String?
  code              String
  kind              KnowledgeNodeKind
  name              String
  description       String?
  sortOrder         Int                      @default(0)
  difficulty        Int?
  importance        Int?
  estimatedMinutes  Int?
  isFoundational    Boolean                  @default(false)
  sourceCoverage    KnowledgeSourceCoverage?
  needsExpertReview Boolean                  @default(false)
  expertReviewNote  String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  knowledgeMap KnowledgeMap    @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  parent       KnowledgeNode?  @relation("KnowledgeNodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     KnowledgeNode[] @relation("KnowledgeNodeHierarchy")

  prerequisiteLinks    KnowledgeDependency[]         @relation("DependentKnowledgeNode")
  unlocksSkills        KnowledgeDependency[]         @relation("PrerequisiteKnowledgeNode")
  examMappings         KnowledgeExamMapping[]
  verification         KnowledgeVerificationMethod[]
  taskLinks            TaskSkill[]
  materialLinks        LearningMaterialSkill[]
  reviewLinks          KnowledgeReviewItemSkill[]
  goalUnstudiedLinks   LearningGoalUnstudiedNode[]
  diagnosticQuestions  DiagnosticQuestionTemplate[]
  assessmentItems      AssessmentItem[]
  diagnosticHypotheses DiagnosticHypothesis[]
  skillEvidence        SkillEvidence[]
  skillStates          StudentSkillState[]
  rubricCriteria       TaskRubricCriterion[]
  reviewCriteria       AssessmentReviewCriterion[]

  @@unique([knowledgeMapId, code])
  @@index([knowledgeMapId, kind, parentId])
}

model KnowledgeDependency {
  skillId           String
  prerequisiteId    String
  type              KnowledgeDependencyType
  rationale         String?
  needsExpertReview Boolean                 @default(false)
  createdAt         DateTime                @default(now())

  skill        KnowledgeNode @relation("DependentKnowledgeNode", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite KnowledgeNode @relation("PrerequisiteKnowledgeNode", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteId])
  @@index([prerequisiteId, type])
}

model KnowledgeExamMapping {
  skillId    String
  examNumber Int
  examPart   ExamPart
  taskType   ExamTaskType
  weight     Float        @default(1)
  createdAt  DateTime     @default(now())

  skill KnowledgeNode @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, examNumber, taskType])
  @@index([examNumber, examPart, taskType])
}

model KnowledgeVerificationMethod {
  skillId     String
  method      SkillVerificationMethod
  description String?
  sortOrder   Int                     @default(0)

  skill KnowledgeNode @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, method])
}

model TaskSkill {
  taskId    String
  skillId   String
  role      TaskSkillRole @default(PRIMARY)
  weight    Float         @default(1)
  createdAt DateTime      @default(now())

  task  Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill KnowledgeNode @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([taskId, skillId])
  @@index([skillId, role])
}

model LearningMaterial {
  id             String               @id @default(cuid())
  knowledgeMapId String
  fileName       String
  title          String
  pageCount      Int
  checksum       String?
  storageKey     String?
  reviewStatus   MaterialReviewStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  knowledgeMap KnowledgeMap              @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  segments     LearningMaterialSegment[]

  @@unique([knowledgeMapId, fileName])
  @@index([knowledgeMapId, reviewStatus])
}

model LearningMaterialSegment {
  id                String   @id @default(cuid())
  materialId        String
  title             String
  pages             Int[]
  notes             String?
  sortOrder         Int      @default(0)
  needsExpertReview Boolean  @default(false)
  createdAt         DateTime @default(now())

  material   LearningMaterial        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  skillLinks LearningMaterialSkill[]

  @@index([materialId, sortOrder])
}

model LearningMaterialSkill {
  segmentId         String
  skillId           String
  role              MaterialSkillRole @default(REFERENCES)
  confidence        Int               @default(100)
  needsExpertReview Boolean           @default(false)

  segment LearningMaterialSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  skill   KnowledgeNode           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([segmentId, skillId])
  @@index([skillId, role])
}

model KnowledgeReviewItem {
  id             String                   @id @default(cuid())
  knowledgeMapId String
  code           String
  type           KnowledgeReviewItemType
  priority       KnowledgeReviewPriority?
  title          String
  description    String
  resolvedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  knowledgeMap KnowledgeMap               @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  skillLinks   KnowledgeReviewItemSkill[]

  @@unique([knowledgeMapId, code])
  @@index([knowledgeMapId, type, priority])
}

model KnowledgeReviewItemSkill {
  reviewItemId String
  skillId      String

  reviewItem KnowledgeReviewItem @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  skill      KnowledgeNode       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([reviewItemId, skillId])
  @@index([skillId])
}

model KnowledgeMapReference {
  id             String @id @default(cuid())
  knowledgeMapId String
  title          String
  url            String
  purpose        String
  sortOrder      Int    @default(0)

  knowledgeMap KnowledgeMap @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)

  @@unique([knowledgeMapId, url])
  @@index([knowledgeMapId, sortOrder])
}

model StudentLearningGoal {
  id                      String             @id @default(cuid())
  publicId                String             @unique
  studentId               String
  knowledgeMapId          String
  targetScore             Int
  examDate                DateTime
  weeklyMinutes           Int
  preferredSessionMinutes Int
  availableWeekdays       Int[]
  lastMockScore           Int?
  status                  LearningGoalStatus @default(ACTIVE)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  student        User                        @relation("StudentLearningGoals", fields: [studentId], references: [id], onDelete: Cascade)
  knowledgeMap   KnowledgeMap                @relation(fields: [knowledgeMapId], references: [id], onDelete: Restrict)
  unstudiedNodes LearningGoalUnstudiedNode[]
  sessions       AssessmentSession[]

  @@index([studentId, status, createdAt])
  @@index([knowledgeMapId])
}

model LearningGoalUnstudiedNode {
  goalId    String
  nodeId    String
  createdAt DateTime @default(now())

  goal StudentLearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  node KnowledgeNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([goalId, nodeId])
  @@index([nodeId])
}

model AssessmentSession {
  id                    String                  @id @default(cuid())
  publicId              String                  @unique
  studentId             String
  goalId                String
  knowledgeMapId        String
  type                  AssessmentSessionType   @default(INITIAL_DIAGNOSTIC)
  status                AssessmentSessionStatus @default(EXAM_READY)
  currentPhase          AssessmentPhase         @default(FULL_EXAM)
  algorithmVersion      String
  examDurationMinutes   Int                     @default(235)
  adaptiveQuestionLimit Int                     @default(8)
  theoryQuestionLimit   Int                     @default(4)
  startedAt             DateTime?
  examSubmittedAt       DateTime?
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  student           User                      @relation("StudentAssessmentSessions", fields: [studentId], references: [id], onDelete: Cascade)
  goal              StudentLearningGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  knowledgeMap      KnowledgeMap              @relation(fields: [knowledgeMapId], references: [id], onDelete: Restrict)
  items             AssessmentItem[]
  events            AssessmentBehaviorEvent[]
  hypotheses        DiagnosticHypothesis[]
  evidence          SkillEvidence[]
  initializedStates StudentSkillState[]       @relation("InitialProfileSession")

  @@index([studentId, status, createdAt])
  @@index([goalId])
  @@index([knowledgeMapId])
}

model DiagnosticQuestionTemplate {
  id               String                   @id @default(cuid())
  knowledgeMapId   String
  targetSkillId    String
  code             String
  kind             DiagnosticQuestionKind
  evaluationMode   QuestionEvaluationMode
  hypothesisType   DiagnosticHypothesisType
  prompt           String
  correctAnswer    String?
  answerOptions    Json?
  estimatedSeconds Int
  difficulty       Int
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  knowledgeMap KnowledgeMap     @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  targetSkill  KnowledgeNode    @relation(fields: [targetSkillId], references: [id], onDelete: Cascade)
  items        AssessmentItem[]

  @@unique([knowledgeMapId, code])
  @@index([targetSkillId, kind, isActive])
}

model AssessmentItem {
  id                 String               @id @default(cuid())
  publicId           String               @unique
  sessionId          String
  taskId             String?
  questionTemplateId String?
  targetSkillId      String?
  phase              AssessmentPhase
  kind               AssessmentItemKind
  examNumber         Int?
  sortOrder          Int
  status             AssessmentItemStatus @default(PENDING)
  promptSnapshot     String?
  selectionReason    Json?
  expectedSeconds    Int?
  maxScore           Float                @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  session          AssessmentSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task             Task?                       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  questionTemplate DiagnosticQuestionTemplate? @relation(fields: [questionTemplateId], references: [id], onDelete: Restrict)
  targetSkill      KnowledgeNode?              @relation(fields: [targetSkillId], references: [id], onDelete: Restrict)
  attempt          AssessmentAttempt?
  events           AssessmentBehaviorEvent[]
  sourceHypotheses DiagnosticHypothesis[]      @relation("HypothesisSourceItem")
  evidence         SkillEvidence[]

  @@unique([sessionId, phase, sortOrder])
  @@index([sessionId, status, phase])
  @@index([taskId])
  @@index([targetSkillId])
}

model AssessmentAttempt {
  id                String                     @id @default(cuid())
  publicId          String                     @unique
  itemId            String                     @unique
  rawAnswer         String?
  solutionText      String?
  confidence        Int?
  independence      AttemptIndependence        @default(UNKNOWN)
  declaredUnstudied Boolean                    @default(false)
  outcome           AssessmentAttemptOutcome
  autoScore         Float?
  awardedScore      Float?
  activeSeconds     Int                        @default(0)
  elapsedSeconds    Int                        @default(0)
  awaySeconds       Int                        @default(0)
  answerChanges     Int                        @default(0)
  firstViewedAt     DateTime?
  submittedAt       DateTime?
  reviewerId        String?
  reviewedAt        DateTime?
  reviewErrorType   AssessmentReviewErrorType?
  reviewComment     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  item           AssessmentItem                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reviewer       User?                         @relation("AssessmentAttemptReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attachments    AssessmentAttemptAttachment[]
  reviewCriteria AssessmentReviewCriterion[]

  @@index([outcome, reviewedAt])
  @@index([reviewerId])
}

model AssessmentAttemptAttachment {
  id           String   @id @default(cuid())
  publicId     String   @unique
  attemptId    String
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model AssessmentBehaviorEvent {
  id         String                      @id @default(cuid())
  sessionId  String
  itemId     String?
  type       AssessmentBehaviorEventType
  occurredAt DateTime
  payload    Json?
  createdAt  DateTime                    @default(now())

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    AssessmentItem?   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([itemId, occurredAt])
}

model DiagnosticHypothesis {
  id            String                     @id @default(cuid())
  sessionId     String
  skillId       String?
  sourceItemId  String?
  key           String
  type          DiagnosticHypothesisType
  status        DiagnosticHypothesisStatus @default(OPEN)
  confidence    Float
  priority      Float
  evidenceCount Int                        @default(1)
  rationale     String
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skill      KnowledgeNode?    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sourceItem AssessmentItem?   @relation("HypothesisSourceItem", fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@unique([sessionId, key])
  @@index([sessionId, status, priority])
  @@index([skillId, type])
}

model SkillEvidence {
  id               String                     @id @default(cuid())
  studentId        String
  skillId          String
  sessionId        String
  assessmentItemId String?
  source           SkillEvidenceSource
  score            Float
  weight           Float
  difficulty       Int?
  skillRole        TaskSkillRole?
  independence     AttemptIndependence        @default(UNKNOWN)
  activeSeconds    Int?
  expectedSeconds  Int?
  selfConfidence   Int?
  errorType        AssessmentReviewErrorType?
  teacherConfirmed Boolean                    @default(false)
  independenceKey  String
  reason           String
  metadata         Json?
  occurredAt       DateTime
  createdAt        DateTime                   @default(now())

  student        User              @relation("StudentSkillEvidence", fields: [studentId], references: [id], onDelete: Cascade)
  skill          KnowledgeNode     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  session        AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assessmentItem AssessmentItem?   @relation(fields: [assessmentItemId], references: [id], onDelete: SetNull)

  @@unique([sessionId, skillId, independenceKey, source])
  @@index([studentId, skillId, occurredAt])
  @@index([sessionId, source])
}

model StudentSkillState {
  studentId              String
  skillId                String
  knowledgeMapId         String
  initializedBySessionId String?
  formulaVersion         String             @default("legacy")
  mastery                Float
  confidence             Float
  evidenceWeight         Float
  evidenceCount          Int
  distinctEvidenceCount  Int
  confirmingAttempts     Int                @default(0)
  contradictingAttempts  Int                @default(0)
  speed                  Float?
  stability              Float?
  status                 StudentSkillStatus
  lastEvidenceAt         DateTime?
  lastVerifiedAt         DateTime?
  reviewDueAt            DateTime?
  needsReview            Boolean            @default(false)
  teacherConfirmedAt     DateTime?
  sourceSummary          Json               @default("{}")
  explanation            Json               @default("{}")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  student              User               @relation("StudentSkillStates", fields: [studentId], references: [id], onDelete: Cascade)
  skill                KnowledgeNode      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  knowledgeMap         KnowledgeMap       @relation(fields: [knowledgeMapId], references: [id], onDelete: Cascade)
  initializedBySession AssessmentSession? @relation("InitialProfileSession", fields: [initializedBySessionId], references: [id], onDelete: SetNull)

  @@id([studentId, skillId])
  @@index([studentId, knowledgeMapId, status])
  @@index([skillId, status])
}

model TaskRubricCriterion {
  id          String  @id @default(cuid())
  taskId      String
  skillId     String?
  code        String
  title       String
  description String?
  maxScore    Float
  sortOrder   Int     @default(0)

  task          Task                        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill         KnowledgeNode?              @relation(fields: [skillId], references: [id], onDelete: SetNull)
  reviewResults AssessmentReviewCriterion[]

  @@unique([taskId, code])
  @@index([skillId])
}

model AssessmentReviewCriterion {
  id                String                    @id @default(cuid())
  attemptId         String
  rubricCriterionId String?
  skillId           String?
  code              String
  title             String
  awardedScore      Float
  maxScore          Float
  errorType         AssessmentReviewErrorType
  comment           String?
  createdAt         DateTime                  @default(now())

  attempt         AssessmentAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  rubricCriterion TaskRubricCriterion? @relation(fields: [rubricCriterionId], references: [id], onDelete: SetNull)
  skill           KnowledgeNode?       @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([attemptId, code])
  @@index([skillId, errorType])
}
